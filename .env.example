# ==============================================================================
# SMC Function Hall — Environment Variables (.env)
# Copy this file to .env and fill in your values.
# On GoDaddy Node.js Hosting, set these in the app's Settings -> secrets instead.
# ==============================================================================

# MySQL database (GoDaddy Node.js Hosting's managed MySQL).
# Either one URL...
# DATABASE_URL=mysql://user:password@host:3306/database
# ...or the separate values (DB_HOST / DB_USER / DB_PASSWORD / DB_NAME also work):
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
# MYSQL_SSL=true   (only if the database requires TLS)

# Without any MySQL settings, the app runs on a local file (data/hotel.db): fine on your
# own computer, but a hosted copy refuses to run without a database.

# Signs logins. Use any long random text, and keep it the same across deploys.
JWT_SECRET=change-me-to-a-long-random-text

# Number of proxies in front of the app (lets login limits see the visitor's real address).
# Leave empty unless you know the hosting's proxy setup.
# TRUST_PROXY=1

PORT=4000
DEMO_MODE=false
