{
  "name": "penta-kedarnath-manager",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Hotel & function hall management system for Penta Kedarnath",
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"node --disable-warning=ExperimentalWarning --watch-path=server --watch server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "serve": "vite build && node --disable-warning=ExperimentalWarning server/index.js"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "bcryptjs": "^3.0.3",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "lucide-react": "^1.64.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.5"
  }
}
